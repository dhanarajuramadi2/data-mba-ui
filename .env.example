# Copy to .env.local (git-ignored) and adjust. Restart `npm run dev` after changes.

# Backend the Vite dev server forwards /api requests to.
# Default when unset: http://127.0.0.1:8000
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Leave empty to use the dev proxy above.
# Set to a full URL (e.g. https://datamba-dev.example.com) to call a shared
# backend directly; that backend must allow this site's origin via CORS.
VITE_API_BASE_URL=
